# Copy to .env only if you want to override docker-compose.yml.
# Do not put a real key in git.

APP_SECRET=replace-with-a-long-random-string
DATABASE_URL=postgresql+psycopg://warranty:warranty@db:5432/warranty
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/storage
SEED_DEMO_USERS=1
RENDER_DPI=300

# AI keys are NOT read from the environment.
# An administrator pastes them into Settings. They are encrypted with APP_SECRET.
